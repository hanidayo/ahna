<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.1</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;RemoteKey.cs" />
    <Compile Include="../../src/Models.cs;../../src/TransferServer.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../server/Common/*.cs" Link="Remote/%(Filename)%(Extension)" />
    <Content Include="../../src/wwwroot/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- QR로 연 웹 페이지(앱 없는 상대) — Windows와 같은 파일 -->
    <Content Include="../../windows/wwwroot/guest.html" Link="wwwroot/guest.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
