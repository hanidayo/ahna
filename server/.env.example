# 아나 서버 설정. 이 파일을 .env 로 복사해서 채우세요. (.env는 다른 사람에게 보여 주지 마세요)

# 서버 주소: 앱에 입력할 주소와 같아야 합니다. https:// 로 시작하고 끝에 / 나 경로가 없어야 합니다.
AHNA_ORIGIN=https://ahna.example.com

# 서버 비밀 키: 64자리 임의 16진수. 만드는 법(리눅스/맥): openssl rand -hex 32
AHNA_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# 초대 코드: 앱을 처음 실행할 때 넣는 코드. 6자 이상, 대소문자 구분 없음. 함께 쓸 사람에게만 알려 주세요.
AHNA_INVITE=AHNA-CHANGE-ME

# 관리자 페이지 비밀번호(8자 이상). {서버 주소}/_ahna/admin 에서 기기 목록·사용량·차단·공지.
# 비워 두면 관리자 페이지가 꺼집니다.
AHNA_ADMIN_PASSWORD=

# (선택) 내려받기 화면 {서버 주소}/download 에 보여 줄 설치 파일 주소. 예: https://github.com/소유자/저장소/releases/latest
AHNA_DOWNLOADS=

# (선택) 하루 사용량 기준 시간대
TZ=Asia/Seoul
