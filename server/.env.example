# 서버 주소 (경로 없는 HTTPS)
AHNA_ORIGIN=https://내주소.synology.me
# 서버 비밀 키: 64자리 이상 임의의 16진수
AHNA_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# 초대 코드: 지인이 처음 실행할 때 입력 (6자 이상, 대소문자 구분 없음)
AHNA_INVITE=AHNA-XXXXXX
# 앱 업데이트 올리기용 키 (GitHub 저장소 비밀값 AHNA_PUBLISH_KEY와 같게, 32자 이상)
AHNA_PUBLISH_KEY=
# 관리자 페이지 비밀번호 (8자 이상). {서버 주소}/_ahna/admin 에서 기기 목록·사용량·차단·초기화. 비워 두면 관리자 페이지가 꺼집니다.
AHNA_ADMIN_PASSWORD=
