<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Ahna</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget><EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Ahna.AppIcon" />
    <EmbeddedResource Include="Ahna.AppIcon" LogicalName="Ahna.AppIcon" />
  </ItemGroup>
<ItemGroup><Compile Remove="ApplicationConfiguration.cs" /></ItemGroup>
  <ItemGroup>
    <!-- QR 창 (NearbyForms.cs): QR 코드 만들기 · MIT -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- GitHub 자동 업데이트 (Updater/UpdateService.cs는 기본 규칙으로 함께 컴파일됩니다) -->
    <EmbeddedResource Include="Updater/apply-update.ps1" LogicalName="Ahna.Update.apply-update.ps1" />
    <None Remove="package/**" />
    <Compile Remove="package/**" />
  </ItemGroup></Project>
